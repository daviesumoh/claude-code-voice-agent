# Deepgram API Key (Get a free key with $200 credits at https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Voice Synthesis Configuration
# Recommended: flux-tanner-en (clear, natural male voice) or flux-alexis-en (female voice)
VOICE_MODEL=flux-tanner-en

# Speech-to-Text Model (Flux conversational STT)
STT_MODEL=flux-general-en

# Voice Speed (0.85 to 1.15 in 0.05 increments, default 1.0)
VOICE_SPEED=1.0

# Expressivity (-2 to 2, 0 is balanced natural conversational)
VOICE_EXPRESSIVITY=0

# Interaction Mode: ACTIVE_CHAT (pastes into active window and speaks) or STANDALONE_VOICE
INPUT_MODE=ACTIVE_CHAT

# Daemon Port (default: 4545)
PORT=4545
