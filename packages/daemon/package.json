{
  "name": "@claude-voice/daemon",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:pill": "swiftc -O -target arm64-apple-macos13.0 src/native-pill.swift -o dist/claude-voice-pill && (cp dist/claude-voice-pill dist/ClaudeVoice.app/Contents/MacOS/claude-voice-pill 2>/dev/null || true)",
    "start": "node ./dist/index.js",
    "pill": "node ./dist/launcher.js",
    "test": "node ./test/run-test.js",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@claude-voice/shared": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "typescript": "^5.5.4"
  }
}
